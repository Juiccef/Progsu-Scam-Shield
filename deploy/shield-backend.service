[Unit]
Description=Shield scam protection backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shield
Group=shield
WorkingDirectory=/opt/shield
EnvironmentFile=/etc/shield/backend.env
Environment=LOG_DIR=/var/lib/shield
ExecStart=/opt/shield/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=shield
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shield

[Install]
WantedBy=multi-user.target
