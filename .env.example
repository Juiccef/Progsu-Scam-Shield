# Copy to .env and fill in. Never commit .env.

# --- Twilio -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Shield proxy number callers dial, in +1XXXXXXXXXX form.
TWILIO_PROXY_NUMBER=
# The protected person's phone and the caregiver's phone. Trial accounts can
# only call and text numbers verified in the Twilio console.
SENIOR_PHONE=
CAREGIVER_PHONE=
# How texts refer to the protected person, for example "Mom".
SENIOR_NAME=your family member
# Public hostname of the tunnel, without https://, for example shield.ngrok-free.app.
# It must match the webhook URL configured in Twilio or signature checks fail.
PUBLIC_HOST=

# --- Speech to text -----------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Scam scorer --------------------------------------------------------
# Model spec. Blank picks gpt-4o-mini if OPENAI_API_KEY is set, else
# claude-haiku-4-5 if ANTHROPIC_API_KEY is set, else rules only.
# Examples: gpt-4o-mini, claude-haiku-4-5, gemini-<model>, groq:<model>, custom:<model>, rules
SCORER_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# custom:<model> talks to any OpenAI-compatible server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=2.5
# Stop reading the model's reply once risk and flags have arrived (faster, no explanation text).
LLM_EARLY_EXIT=true
# true/false forces schema-enforced JSON on or off. Blank keeps each provider's default.
LLM_STRICT_JSON=

# --- Decisions (tune with eval/run_eval.py) -------------------------------
WARN_THRESHOLD=60
END_THRESHOLD=85
CONSECUTIVE_REQUIRED=2
GRACE_PERIOD_S=10
# Rules and LLM both over a threshold in one evaluation count as two confirmations.
AGREEMENT_CONFIRMS=true
WINDOW_S=40
SCORE_INTERVAL_S=2.5
# Comma-separated numbers that are connected without any monitoring.
ALLOWLIST=

# --- Operations -----------------------------------------------------------
# true: log actions instead of sending them (no hang-up, no SMS). Use with tools/fake_call.py.
DRY_RUN_ACTIONS=false
# true: allow POST /demo/call, which plays an eval script through the real scoring with
# no phone and no Twilio. Demo calls are tagged "simulated" and their actions are always dry-run.
DEMO_MODE=false
# Only turn off for local experiments. Webhooks are then accepted from anyone.
TWILIO_VALIDATE_SIGNATURE=true
# If set, app APIs including /messages and /messages/analyze require
# ?token=... or "Authorization: Bearer ...". Set before exposing the server.
EVENTS_TOKEN=
# Development only: also print final transcripts in the server log.
LOG_TRANSCRIPTS=false
# Twilio <Say> voice. "default" uses Twilio's basic voice.
SAY_VOICE=Polly.Joanna-Neural
# Caller ID the senior sees. Blank passes the real caller's number through.
DIAL_CALLER_ID=
# Which Media Streams track carries the caller. Twilio documents "inbound"; switch to
# "outbound" only if a test call shows the speaker labels swapped.
CALLER_TRACK=inbound

# --- Twilio protected SMS + Photon caregiver agent (opt-in) ---------------
# SMS to TWILIO_PROXY_NUMBER is queued for screening. Photon handles caregiver
# alerts/commands through iMessage; it does not deliver the senior's texts.
TEXT_GATEWAY_ENABLED=false
# Keep false while staging. Caregiver alerts can still be delivered; senior
# relay jobs stay queued until this is true and the backend is restarted.
TEXT_FORWARDING_ENABLED=false
# Live SMS also requires DRY_RUN_ACTIONS=false and Twilio credentials. Sender is
# always TWILIO_PROXY_NUMBER, even if TWILIO_SMS_FROM differs for voice alerts.
# SENIOR_PHONE must be the senior's actual phone, never the Twilio number.
# Optional dedicated Photon caregiver line. Leave empty on Free/Pro shared plans.
PHOTON_LINE=
# Defaults to CAREGIVER_PHONE. May be the caregiver's iMessage email address.
PHOTON_CAREGIVER_ADDRESS=
# Must be distinct from EVENTS_TOKEN. Internal API bearer token, Node -> Python.
PHOTON_BRIDGE_TOKEN=
# Generate once; keep stable across restarts. Never commit the key.
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GATEWAY_ENCRYPTION_KEY=
# Only the Spectrum service needs these Photon project credentials.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SHIELD_BACKEND_URL=http://127.0.0.1:8000
