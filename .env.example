# Copy to .env and fill in. Never commit .env.

# --- Twilio -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Palisade proxy number callers dial, in +1XXXXXXXXXX form.
TWILIO_PROXY_NUMBER=
# The protected person's phone and the caregiver's phone. Trial accounts can
# only call and text numbers verified in the Twilio console.
SENIOR_PHONE=
CAREGIVER_PHONE=
# How texts refer to the protected person, for example "Mom".
SENIOR_NAME=your family member
# Public hostname of the tunnel, without https://, for example palisade.ngrok-free.app.
# It must match the webhook URL configured in Twilio or signature checks fail.
PUBLIC_HOST=

# --- Speech to text -----------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Scam scorer --------------------------------------------------------
# Model spec. Blank picks gpt-4o-mini if OPENAI_API_KEY is set, else
# claude-haiku-4-5 if ANTHROPIC_API_KEY is set, else rules only.
# Examples: gpt-4o-mini, claude-haiku-4-5, gemini-<model>, groq:<model>, vultr:<model>,
# vultr-decision:<model>, jev-latest, custom:<model>, rules
SCORER_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Vultr Serverless Inference: vultr:<chat model>, or vultr-decision:<decision model> for a
# model that answers with probabilities and writes no text. The key is on the subscription's
# Overview page in the Vultr console. Model IDs: curl https://api.vultrinference.com/v1/models
VULTR_INFERENCE_API_KEY=
# Jev, TypeSafe AI's decision model: jev-latest (or typesafe:<model>). Like vultr-decision it
# answers with probabilities and writes no text. Key: https://console.typesafe.ai/keys
# EXPERIMENTAL: never measured. Leave SCORER_MODEL alone until docs/jev-testing.md is done.
TYPESAFE_API_KEY=
# custom:<model> talks to any OpenAI-compatible server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=2.5
# Stop reading the model's reply once risk and flags have arrived (faster, no explanation text).
LLM_EARLY_EXIT=true
# true/false forces schema-enforced JSON on or off. Blank keeps each provider's default.
LLM_STRICT_JSON=

# --- Decisions (tune with eval/run_eval.py) -------------------------------
WARN_THRESHOLD=60
END_THRESHOLD=85
CONSECUTIVE_REQUIRED=2
GRACE_PERIOD_S=10
# Rules and LLM both over a threshold in one evaluation count as two confirmations.
AGREEMENT_CONFIRMS=true
WINDOW_S=40
SCORE_INTERVAL_S=2.5
# Comma-separated numbers that are connected without any monitoring.
ALLOWLIST=

# --- Operations -----------------------------------------------------------
# true: log actions instead of sending them (no hang-up, no SMS). Use with tools/fake_call.py.
DRY_RUN_ACTIONS=false
# true: allow POST /demo/call, which plays an eval script through the real scoring with
# no phone and no Twilio. Demo calls are tagged "simulated" and their actions are always dry-run.
DEMO_MODE=false
# Only turn off for local experiments. Webhooks are then accepted from anyone.
TWILIO_VALIDATE_SIGNATURE=true
# If set, everything the app and the dashboard read (/events, /calls, /metrics/last and the
# text endpoints) requires ?token=... or "Authorization: Bearer ...". Set it before exposing
# the server.
EVENTS_TOKEN=
# Sign-in with Auth0 (docs/auth0-sign-in.md). With AUTH0_DOMAIN set, a caregiver signs in and
# the server lets in the verified emails in CAREGIVER_EMAILS (comma-separated). EVENTS_TOKEN,
# where it is still set, keeps working for your own tools.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_WEB_CLIENT_ID=
AUTH0_IOS_CLIENT_ID=
CAREGIVER_EMAILS=
# Development only: also print final transcripts in the server log.
LOG_TRANSCRIPTS=false
# Twilio <Say> voice. "default" uses Twilio's basic voice.
SAY_VOICE=Polly.Joanna-Neural
# Caller ID the senior sees. Blank passes the real caller's number through.
DIAL_CALLER_ID=
# Which Media Streams track carries the caller. Twilio documents "inbound"; switch to
# "outbound" only if a test call shows the speaker labels swapped.
CALLER_TRACK=inbound

# --- Vultr hosting (tools/vultr_deploy.py) ----------------------------------
# Account API key (Vultr console: Account, API; allow your IP address there). It is used on
# this computer to create the server and is never sent to it.
VULTR_API_KEY=

# --- Text protection (off unless switched on; deploy/README.md has the steps) ---------
# Texts sent to TWILIO_PROXY_NUMBER are stored encrypted, scored, and held for the caregiver
# when they look risky. With this off, such a text is only scored and nothing is kept of it.
TEXT_GATEWAY_ENABLED=false
# Sends the texts that passed on to SENIOR_PHONE, from TWILIO_PROXY_NUMBER. While this is
# off they wait. It also needs DRY_RUN_ACTIONS=false and the Twilio account above.
TEXT_FORWARDING_ENABLED=false
# Encrypts the stored texts. Make it once and keep it: with another key, texts that are
# already waiting cannot be read. Never commit it.
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GATEWAY_ENCRYPTION_KEY=
# The iMessage agent in photon/ tells the caregiver about a held text. It never sees a
# text's words. This is the token it and the server share; not the same as EVENTS_TOKEN.
PHOTON_BRIDGE_TOKEN=
# Where the caregiver gets iMessages, when that is not CAREGIVER_PHONE. An email address works.
PHOTON_CAREGIVER_ADDRESS=
# A dedicated Photon line, if the project has one. Leave empty on Photon's shared plans.
PHOTON_LINE=
# From the Photon project. Only the agent reads these two.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Where the agent finds the server, which has to be this same machine.
SHIELD_BACKEND_URL=http://127.0.0.1:8000
